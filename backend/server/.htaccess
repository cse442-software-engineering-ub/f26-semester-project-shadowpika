Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal code, tests, and secrets are never served.
    RewriteRule ^(includes|listing/lib|karavan_uploads)(/|$) - [F,L]
    RewriteRule ^(config\.local\.php|config\.local\.example\.php|composer\.(json|lock)|phpunit\.xml)$ - [F,L]

    # Client-side routes of the React app.
    RewriteRule ^(admin-register|moderator)/?$ index.html [L]
</IfModule>
